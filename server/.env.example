PORT=5000
# MongoDB connection URI (Local or MongoDB Atlas free cloud cluster):
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/choudhary_interiors?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/choudhary_interiors
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@cfinteriors.com
ADMIN_PASSWORD=your_secure_admin_password
